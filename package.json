{
	"name": "@shambay/validation",
	"version": "1.0.1",
	"description": "Unified validation abstraction layer with pluggable adapters (Zod, Yup, Joi, etc.)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sham-bay/ts-validation.git"
	},
	"bugs": {
		"url": "https://github.com/sham-bay/ts-validation/issues"
	},
	"homepage": "https://github.com/sham-bay/ts-validation",
	"license": "Apache-2.0",
	"author": "Sham Bay <sham.bay@use_social_to_contact.me>",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "pnpm run build",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"peerDependencies": {
		"zod": "^4.4.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.11"
	},
	"keywords": [
		"validation",
		"adapter",
		"zod",
		"yup",
		"joi",
		"typescript"
	],
	"packageManager": "pnpm@11.21.0"
}
